{
  "name": "@cipher-lab/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript cipher and cryptanalysis engine: modular arithmetic, Caesar/affine/substitution ciphers, frequency analysis, group tools. Zero runtime dependencies.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "eval": "vitest run -c vitest.eval.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "fast-check": "4.11.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
