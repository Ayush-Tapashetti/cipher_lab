  "state_machines": [
    {
      "entity": "BreakCandidate",
      "states": [
        "ranked",
        "selected",
        "rejected"
      ],
      "initial": "ranked",
      "transitions": [
        {
          "from": "ranked",
          "event": "select",
          "to": "selected",
          "guard": "no other candidate of the profile is selected"
        },
        {
          "from": "selected",
          "event": "deselect",
          "to": "ranked",
          "guard": "none"
        },
        {
          "from": "ranked",
          "event": "reject",
          "to": "rejected",
          "guard": "none"
        },
        {
          "from": "rejected",
          "event": "restore",
          "to": "ranked",
          "guard": "none"
        },
        {
          "from": "selected",
          "event": "select_other",
          "to": "ranked",
          "guard": "another candidate of the profile was selected"
        }
      ]
    }
  ],
